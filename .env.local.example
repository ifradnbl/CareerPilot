# CareerPilot — local environment variables
#
# USAGE
#   1. Copy this file to `.env.local` in the same folder
#        cp .env.local.example .env.local
#   2. Replace every `PASTE_..._HERE` placeholder with your real value
#   3. Restart `npm run dev` so Next.js reloads the env
#
# NOTE
#   `.env.local` is git-ignored by Next.js by default. NEVER commit it.
#   Only variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.

# ---- LLM (Anthropic Claude) ----
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_API_KEY_HERE
LLM_PROVIDER=anthropic
# LLM_API_KEY=PASTE_LLM_API_KEY_HERE
# LLM_API_KEY is read by src/server/config/env.ts — set it to the same
# value as ANTHROPIC_API_KEY if you want getEnv() to satisfy its check.

# ---- Database ----
DATABASE_URL=PASTE_DATABASE_URL_HERE
# Example: postgres://user:password@localhost:5432/careerpilot

# ---- Job Search provider ----
# Choose one of: adzuna | serpapi | jsearch
JOB_SEARCH_PROVIDER=adzuna
JOB_SEARCH_API_KEY=PASTE_JOB_SEARCH_API_KEY_HERE

# ---- Adzuna (used by src/app/api/job-search/route.ts) ----
# Get your keys: https://developer.adzuna.com/
ADZUNA_APP_ID=PASTE_ADZUNA_APP_ID_HERE
ADZUNA_APP_KEY=PASTE_ADZUNA_APP_KEY_HERE

# ---- Tavily (used by src/app/api/job-search/route.ts) ----
# Get your key: https://tavily.com/
TAVILY_API_KEY=PASTE_TAVILY_API_KEY_HERE

# ---- Vector store ----
# Choose one of: pgvector | pinecone | chroma
VECTOR_STORE_PROVIDER=pgvector
# VECTOR_STORE_URL=PASTE_VECTOR_STORE_URL_HERE

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
